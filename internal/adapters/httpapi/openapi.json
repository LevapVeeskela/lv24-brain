{
  "openapi": "3.1.0",
  "info": {
    "title": "LV24 Brain Server API",
    "version": "0.1.0",
    "description": "Single-node brain server: authentication, projects, knowledge, search, revisions and SSE notifications.",
    "license": { "name": "Apache-2.0" }
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT or brain API token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "example": "invalid_argument" },
              "message": { "type": "string" },
              "currentRevision": { "type": "integer", "format": "int64" },
              "mergeHint": { "type": "string" }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "login": { "type": "string" },
          "displayName": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "member", "viewer"] },
          "authSource": { "type": "string" },
          "revision": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Session": {
        "type": "object",
        "required": ["accessToken", "refreshToken", "expiresAt", "user"],
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "kind": { "type": "string", "enum": ["app", "service", "repository", "infra", "other"] },
          "repoUrl": { "type": "string" },
          "defaultBranch": { "type": "string" },
          "revision": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "State": {
        "type": "object",
        "properties": {
          "projectId": { "type": "string" },
          "goal": { "type": "string" },
          "active": { "type": "array", "items": { "type": "string" } },
          "blocked": { "type": "array", "items": { "type": "string" } },
          "nextAction": { "type": "string" },
          "openQuestions": { "type": "array", "items": { "type": "string" } },
          "freshUntil": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "format": "int64" }
        }
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "permalink": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "format": "int64" }
        }
      },
      "Decision": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string", "enum": ["proposed", "accepted", "rejected", "superseded"] },
          "context": { "type": "string" },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "consequences": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "permalink": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "format": "int64" }
        }
      },
      "Attempt": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "title": { "type": "string" },
          "hypothesis": { "type": "string" },
          "result": { "type": "string" },
          "reason": { "type": "string" },
          "permalink": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "format": "int64" }
        }
      },
      "Handoff": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "summary": { "type": "string" },
          "gitContext": { "type": "string" },
          "nextAction": { "type": "string" },
          "permalink": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "format": "int64" }
        }
      },
      "SearchHit": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "snippet": { "type": "string" },
          "score": { "type": "number" }
        }
      },
      "Revision": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "kind": { "type": "string", "enum": ["git", "server"] },
          "actor": { "type": "string" },
          "entityKind": { "type": "string" },
          "entityId": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "object", "additionalProperties": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ConnectorRun": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string", "enum": ["github", "gitlab", "imap"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["running", "success", "partial", "failed"] },
          "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
          "error": { "type": "string" },
          "revision": { "type": "integer", "format": "int64" }
        }
      },
      "ConnectorRunRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "enum": ["github", "gitlab", "imap"] },
          "projects": { "type": "array", "items": { "type": "string" } },
          "since": { "type": "string", "format": "date-time" },
          "limit": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Process liveness",
        "security": [],
        "responses": { "200": { "description": "Alive" } }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness including store connectivity",
        "security": [],
        "responses": {
          "200": { "description": "Ready" },
          "503": { "description": "Unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Build identity",
        "security": [],
        "responses": { "200": { "description": "Version info" } }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": { "200": { "description": "OpenAPI document" } }
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Local email/password login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login", "password"],
                "properties": { "login": { "type": "string" }, "password": { "type": "string", "format": "password" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
          "401": { "description": "Invalid credentials" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "summary": "Rotate a refresh token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": { "refreshToken": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
          "401": { "description": "Invalid refresh token" }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Revoke the current session family",
        "responses": {
          "204": { "description": "Revoked" },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/v1/auth/password": {
      "post": {
        "summary": "Change the caller's local password. Verifies the current password, then revokes every other login session of the account (the caller's current session is kept). API tokens and the current access token are not affected. Local accounts only.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["current_password", "new_password"], "properties": { "current_password": { "type": "string" }, "new_password": { "type": "string", "minLength": 10 } } } } }
        },
        "responses": {
          "204": { "description": "Changed; other sessions revoked" },
          "400": { "description": "New password fails policy or equals the current one", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthenticated" },
          "403": { "description": "Wrong current password (code invalid_current_password) or account is not local (code forbidden)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Too many attempts for this account" }
        }
      }
    },
    "/v1/auth/sessions/revoke-all": {
      "post": {
        "summary": "Revoke every login session of the caller, including the current one. The current access token is rejected immediately. API tokens are not revoked.",
        "responses": {
          "204": { "description": "All login sessions revoked" },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "summary": "Current principal",
        "responses": {
          "200": { "description": "Principal" },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/v1/auth/oidc/login": {
      "get": {
        "summary": "Start OIDC authorization code + PKCE login",
        "security": [],
        "responses": {
          "302": { "description": "Redirect to the identity provider" },
          "501": { "description": "OIDC is not configured" }
        }
      }
    },
    "/v1/auth/oidc/callback": {
      "get": {
        "summary": "OIDC callback; returns a session",
        "security": [],
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
          "400": { "description": "Invalid state or code" },
          "401": { "description": "Identity provider rejected the login" }
        }
      }
    },
    "/v1/users": {
      "get": {
        "summary": "List users (admin)",
        "responses": { "200": { "description": "Users" }, "403": { "description": "Forbidden" } }
      },
      "post": {
        "summary": "Create a user (admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login"],
                "properties": {
                  "login": { "type": "string" },
                  "displayName": { "type": "string" },
                  "password": { "type": "string", "format": "password" },
                  "role": { "type": "string", "enum": ["admin", "member", "viewer"] },
                  "authSource": { "type": "string", "enum": ["local", "oidc"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "400": { "description": "Validation error" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/v1/users/{id}/sessions/revoke": {
      "post": {
        "summary": "Revoke every login session of a user (admin). Their access tokens are rejected immediately; their API tokens are not revoked.",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "204": { "description": "All login sessions of the user revoked" },
          "403": { "description": "Admin role required" },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/users/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "Get a user (admin)", "responses": { "200": { "description": "User" }, "404": { "description": "Not found" } } },
      "patch": { "summary": "Update a user (admin)", "responses": { "200": { "description": "Updated" }, "409": { "description": "Revision conflict (code conflict), or the change would leave no admin (code last_admin)" } } },
      "delete": {
        "summary": "Delete a user (admin)",
        "parameters": [{ "name": "revision", "in": "query", "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "204": { "description": "Deleted" }, "409": { "description": "Revision conflict (code conflict), or the change would leave no admin (code last_admin)" } }
      }
    },
    "/v1/tokens": {
      "get": {
        "summary": "List API tokens for the current user (admin may list all)",
        "responses": { "200": { "description": "Tokens" } }
      },
      "post": {
        "summary": "Mint a scoped API token; the raw token is returned once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "role": { "type": "string", "enum": ["admin", "member", "viewer"] },
                  "userId": { "type": "string" },
                  "expiresInDays": { "type": "integer", "minimum": 1, "maximum": 3650, "description": "Optional lifetime in days from now. Omit both expiry fields for a token that never expires." },
                  "expiresAt": { "type": "string", "format": "date-time", "description": "Optional RFC 3339 expiry instant. Must be in the future and at most 10 years away. Cannot be combined with expiresInDays." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created token. The response is {token, apiToken}; apiToken.expiresAt is present only when the token expires." },
          "400": { "description": "Validation error, for example both expiry fields set or an expiry out of range" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/v1/tokens/{id}": {
      "delete": {
        "summary": "Revoke an API token",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Revoked" }, "404": { "description": "Not found" } }
      }
    },
    "/v1/projects": {
      "get": {
        "summary": "List projects",
        "responses": { "200": { "description": "Projects" } }
      },
      "post": {
        "summary": "Create a project (member or admin)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } },
        "responses": { "201": { "description": "Created" }, "403": { "description": "Forbidden" } }
      }
    },
    "/v1/projects/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "Get a project", "responses": { "200": { "description": "Project" }, "404": { "description": "Not found" } } },
      "patch": {
        "summary": "Update a project with optimistic revision",
        "responses": { "200": { "description": "Updated" }, "409": { "description": "Revision conflict" } }
      },
      "delete": {
        "summary": "Delete a project (admin)",
        "parameters": [{ "name": "revision", "in": "query", "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "204": { "description": "Deleted" }, "409": { "description": "Revision conflict" } }
      }
    },
    "/v1/projects/{id}/state": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "Get project state", "responses": { "200": { "description": "State" }, "404": { "description": "Not found" } } },
      "put": { "summary": "Replace project state (member or admin)", "responses": { "200": { "description": "State" }, "409": { "description": "Revision conflict" } } }
    },
    "/v1/projects/{id}/notes": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "List notes", "responses": { "200": { "description": "Notes" } } },
      "post": { "summary": "Create a note", "responses": { "201": { "description": "Created" }, "403": { "description": "Forbidden" } } }
    },
    "/v1/notes/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "Get a note", "responses": { "200": { "description": "Note" }, "404": { "description": "Not found" } } },
      "patch": { "summary": "Update a note", "responses": { "200": { "description": "Updated" }, "409": { "description": "Revision conflict" } } },
      "delete": { "summary": "Delete a note", "responses": { "204": { "description": "Deleted" }, "409": { "description": "Revision conflict" } } }
    },
    "/v1/projects/{id}/decisions": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "List decisions", "responses": { "200": { "description": "Decisions" } } },
      "post": { "summary": "Create a decision", "responses": { "201": { "description": "Created" } } }
    },
    "/v1/decisions/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "Get a decision", "responses": { "200": { "description": "Decision" } } },
      "patch": { "summary": "Update a decision", "responses": { "200": { "description": "Updated" }, "409": { "description": "Revision conflict" } } },
      "delete": { "summary": "Delete a decision", "responses": { "204": { "description": "Deleted" } } }
    },
    "/v1/projects/{id}/attempts": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "List attempts", "responses": { "200": { "description": "Attempts" } } },
      "post": { "summary": "Create an attempt", "responses": { "201": { "description": "Created" } } }
    },
    "/v1/attempts/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "Get an attempt", "responses": { "200": { "description": "Attempt" } } },
      "patch": { "summary": "Update an attempt", "responses": { "200": { "description": "Updated" }, "409": { "description": "Revision conflict" } } },
      "delete": { "summary": "Delete an attempt", "responses": { "204": { "description": "Deleted" } } }
    },
    "/v1/projects/{id}/handoffs": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "List handoffs", "responses": { "200": { "description": "Handoffs" } } },
      "post": { "summary": "Create an immutable handoff", "responses": { "201": { "description": "Created" } } }
    },
    "/v1/handoffs/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "summary": "Get a handoff", "responses": { "200": { "description": "Handoff" } } },
      "delete": { "summary": "Delete a handoff", "responses": { "204": { "description": "Deleted" } } }
    },
    "/v1/search": {
      "get": {
        "summary": "Full-text search over knowledge, ranked by relevance",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "kind", "in": "query", "description": "Keep only these kinds; repeatable", "schema": { "type": "string", "enum": ["note", "decision", "attempt", "handoff", "state", "dump"] } },
          { "name": "exclude_kind", "in": "query", "description": "Drop these kinds; repeatable", "schema": { "type": "string", "enum": ["note", "decision", "attempt", "handoff", "state", "dump"] } }
        ],
        "responses": {
          "200": { "description": "Hits" },
          "400": { "description": "Invalid query, such as an unknown kind" }
        }
      }
    },
    "/v1/audit": {
      "get": {
        "summary": "Audit log (admin): entity changes and security events such as logins, token lifecycle and OIDC linking",
        "parameters": [
          { "name": "actor", "in": "query", "schema": { "type": "string" } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "entityKind", "in": "query", "schema": { "type": "string" } },
          { "name": "entityId", "in": "query", "schema": { "type": "string" } },
          { "name": "since", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "until", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Audit events, newest first" },
          "400": { "description": "Invalid filter" },
          "403": { "description": "Admin role required" }
        }
      }
    },
    "/v1/revisions": {
      "get": {
        "summary": "List server revisions",
        "parameters": [
          { "name": "after", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "entityKind", "in": "query", "schema": { "type": "string" } },
          { "name": "entityId", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Revisions" } }
      }
    },
    "/v1/events/ticket": {
      "post": {
        "summary": "Issue a single-use, one-minute ticket for GET /v1/events",
        "responses": {
          "201": {
            "description": "Ticket",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "ticket": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" } } } } }
          },
          "401": { "description": "Unauthenticated" },
          "429": { "description": "Too many outstanding tickets" }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "Server-sent revision events with heartbeat and Last-Event-ID replay",
        "parameters": [
          { "name": "Last-Event-ID", "in": "header", "schema": { "type": "string" } },
          { "name": "ticket", "in": "query", "description": "Single-use ticket from POST /v1/events/ticket, for EventSource clients that cannot send an Authorization header. Access tokens are never accepted in the URL.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": { "text/event-stream": { "schema": { "type": "string" } } }
          },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/v1/connectors/run": {
      "post": {
        "summary": "Run a read-only GitHub, GitLab, or IMAP connector (admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConnectorRunRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed run record; inspect status for success, partial, or failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConnectorRun" }
              }
            }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Admin role required" },
          "501": { "description": "Connector runner is not configured" }
        }
      }
    },
    "/v1/connectors/runs": {
      "get": {
        "summary": "List connector runs, newest first",
        "parameters": [
          { "name": "source", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["running", "success", "partial", "failed"] } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Connector runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/ConnectorRun" } }
                  }
                }
              }
            }
          },
          "400": { "description": "Unknown status filter" }
        }
      }
    },
    "/v1/connectors/runs/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "summary": "Get one connector run",
        "responses": {
          "200": { "description": "Connector run", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConnectorRun" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/connectors/runs/{id}/markdown": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "summary": "Export one connector run as Markdown",
        "responses": {
          "200": {
            "description": "Markdown run record",
            "content": { "text/markdown": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Not found" }
        }
      }
    }
  }
}
