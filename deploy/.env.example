# LV24 Brain server environment template.
#
# Copy to deploy/.env and fill the values. Never commit a filled .env.
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build
#
# Generate secrets locally (do not reuse examples):
#   Linux/macOS:  openssl rand -base64 48
#   PowerShell:   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#
# BRAIN_DATABASE_URL must use the same password as BRAIN_DB_PASSWORD.
# Percent-encode URL-special characters in the URL form.

# Optional: a published server image instead of the local build, pinned to a
# release, e.g. ghcr.io/levapveeskela/lv24-brain-server:0.6.2. Empty builds
# lv24-brain-server:local from source.
BRAIN_SERVER_IMAGE=

# Required: Postgres password. Use URL-safe characters or percent-encode them
# in BRAIN_DATABASE_URL below.
BRAIN_DB_PASSWORD=

# Required: full server persistence URL. Keep the password in sync above.
# Example: postgres://brain:<url-encoded-password>@postgres:5432/brain?sslmode=disable
BRAIN_DATABASE_URL=

# Optional: Postgres health/migration timeout, Go duration (for example 30s).
# Empty uses the server default of 30s.
BRAIN_DATABASE_TIMEOUT=

# Optional: pgx pool size per replica. Empty uses 10 (range 1-200). Keep the
# total across replicas below the Postgres max_connections setting.
BRAIN_DATABASE_MAX_CONNS=

# Optional: per-statement timeout sent to Postgres as statement_timeout.
# Go duration; empty uses 30s; 0 disables it. Raise it temporarily before a
# large migration if it is too short (range 1s-1h).
BRAIN_DATABASE_STATEMENT_TIMEOUT=

# Optional: Prometheus metrics. Off unless set to 1. Metrics are served only on
# BRAIN_METRICS_ADDR (default 127.0.0.1:9090 inside the container), never on the
# public API port. See docs/runbook.md, "Metrics".
BRAIN_METRICS_ENABLED=
BRAIN_METRICS_ADDR=

# Optional: retention job. It deletes old audit events, revisions, expired
# refresh tokens, stale auth tombstones and long-expired API tokens. Set
# BRAIN_RETENTION_DISABLED=1 to turn it off. Windows accept "180d" or a Go
# duration; empty uses the defaults shown.
BRAIN_RETENTION_DISABLED=
BRAIN_AUDIT_RETENTION=180d
BRAIN_REVISION_RETENTION=90d
BRAIN_RETENTION_INTERVAL=6h

# Set to 1 only after taking a Postgres backup (see docs/deploy.md). It allows
# the server to apply pending migrations to an existing schema. Leave empty
# otherwise; migrations are forward-only.
BRAIN_DATABASE_BACKUP_CONFIRMED=

# Required: JWT signing key, at least 32 bytes.
BRAIN_JWT_SECRET=

# Optional: first administrator (local password auth). Leave empty when OIDC
# is your only login path.
BRAIN_BOOTSTRAP_ADMIN_LOGIN=
BRAIN_BOOTSTRAP_ADMIN_PASSWORD=

# Optional OIDC provider. Leave empty to disable OIDC.
BRAIN_OIDC_ISSUER=
BRAIN_OIDC_CLIENT_ID=
BRAIN_OIDC_CLIENT_SECRET=
BRAIN_OIDC_REDIRECT_URL=

# Optional: login attempts per minute, per client address and per account.
# Empty uses the default of 20; 0 disables the limit.
BRAIN_LOGIN_RATE_LIMIT=

# Optional: reverse proxies whose X-Forwarded-For is trusted for login rate
# limiting (comma-separated IPs/CIDRs). Leave empty when not behind a proxy.
BRAIN_TRUSTED_PROXIES=

# Listener bind address. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0
# only when another host must reach the server directly.
BRAIN_BIND_ADDR=127.0.0.1
BRAIN_PORT=8080

# Reserved for a future server auto-updater; not wired in v1.
BRAIN_SERVER_AUTO_UPDATE=0
